# talabflow configuration.
#
# Copy to .env and edit. .env is git-ignored and must never be committed.
# Every value below is a PLACEHOLDER -- no real credential appears in this file.

# ---------------------------------------------------------------- environment
# "production" turns on strict startup checks: a real JWT secret is required and
# a wildcard CORS origin is refused. Keep "development" for local work.
TALABFLOW_ENVIRONMENT=development

# ---------------------------------------------------------------- database
# SQLite by default. PostgreSQL works with no code change:
#   postgresql+psycopg://talabflow:PASSWORD@localhost:5432/talabflow
TALABFLOW_DATABASE_URL=sqlite:///data/talabflow.sqlite3
TALABFLOW_SQL_ECHO=false

# ---------------------------------------------------------------- authentication
# REQUIRED in production. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup refuses this literal placeholder when ENVIRONMENT=production.
TALABFLOW_JWT_SECRET=change-me
TALABFLOW_JWT_ALGORITHM=HS256
TALABFLOW_ACCESS_TOKEN_TTL_MINUTES=60

# ---------------------------------------------------------------- messaging
# scripted -> offline in-memory transport; no token, no network  (default)
# telegram -> the real Bot API via long polling; needs a token
TALABFLOW_TRANSPORT=scripted

# PLACEHOLDER. Get a real token from @BotFather on Telegram (free).
# Never commit a real token.
TALABFLOW_TELEGRAM_BOT_TOKEN=123456789:replace-me-with-your-botfather-token
TALABFLOW_TELEGRAM_API_BASE=https://api.telegram.org
TALABFLOW_TELEGRAM_POLL_TIMEOUT_SECONDS=25
TALABFLOW_HTTP_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------- bot behaviour
TALABFLOW_BUSINESS_NAME=Nour Technical Services
# Customer-facing language: en or ar
TALABFLOW_DEFAULT_LANGUAGE=en
# Comma-separated menu of services offered. Must be non-empty and unique.
TALABFLOW_SERVICE_TYPES=Repair,Installation,Consultation,Maintenance
TALABFLOW_USER_MESSAGES_PER_MINUTE=20
TALABFLOW_MAX_MESSAGE_LENGTH=1000

# ---------------------------------------------------------------- outbox worker
TALABFLOW_OUTBOX_BATCH_SIZE=20
TALABFLOW_OUTBOX_MAX_ATTEMPTS=5
TALABFLOW_OUTBOX_BACKOFF_BASE_SECONDS=30
TALABFLOW_OUTBOX_POLL_INTERVAL_SECONDS=5

# ---------------------------------------------------------------- admin API
TALABFLOW_API_RATE_LIMIT_PER_MINUTE=120
# Comma-separated browser origins. Empty disables CORS. "*" is refused in production.
TALABFLOW_CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------- logging
TALABFLOW_LOG_LEVEL=INFO
